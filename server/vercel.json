{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/router?path=wellknown&type=as" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/router?path=wellknown&type=as" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/router?path=wellknown&type=pr" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/router?path=wellknown&type=pr" },
    { "source": "/oauth/authorize", "destination": "/authorize.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/verify", "destination": "/api/router?path=verify" },
    { "source": "/.well-known/security.txt", "destination": "/security.txt" },
    { "source": "/.well-known/openai-apps-challenge", "destination": "/api/router?path=challenge" },
    { "source": "/mcp", "destination": "/api/router?path=mcp" },
    { "source": "/api/:path*", "destination": "/api/router?path=:path*" }
  ],
  "functions": {
    "api/router.js": { "maxDuration": 60 }
  }
}
